  {
    "name": "ft_countdown",
    "level": 0,
    "type": "program",
    "subject": {
      "assignment": "ft_countdown",
      "files": [
        "ft_countdown.c"
      ],
      "allowed": [
        "write"
      ],
      "description": "Write a program that displays all digits in descending order, followed by a\nnewline.\n\nExample:\n$> ./ft_countdown | cat -e\n9876543210$\n$>"
    },
    "referenceCode": "/* ************************************************************************** */\n/*                                                                            */\n/*                                                        :::      ::::::::   */\n/*   ft_countdown.c                                     :+:      :+:    :+:   */\n/*                                                    +:+ +:+         +:+     */\n/*   By: fwuensch <fwuensch@student.42.fr>          +#+  +:+       +#+        */\n/*                                                +#+#+#+#+#+   +#+           */\n/*   Created: 2017/07/14 11:55:17 by fwuensch          #+#    #+#             */\n/*   Updated: 2017/07/14 11:55:18 by fwuensch         ###   ########.fr       */\n/*                                                                            */\n/* ************************************************************************** */\n\n#include <unistd.h>\n\nint\t\tmain(void)\n{\n\tchar c;\n\n\tc = '9';\n\twhile (c >= '0')\n\t{\n\t\twrite(1, &c, 1);\n\t\tc--;\n\t}\n\twrite(1, \"\\n\", 1);\n\treturn (0);\n}\n",
