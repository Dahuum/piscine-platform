    "referenceCode": "/* ************************************************************************** */\n/*                                                                            */\n/*                                                        :::      ::::::::   */\n/*   aff_last_param.c                                   :+:      :+:    :+:   */\n/*                                                    +:+ +:+         +:+     */\n/*   By: angavrel <angavrel@student.42.fr>          +#+  +:+       +#+        */\n/*                                                +#+#+#+#+#+   +#+           */\n/*   Created: 2016/12/07 17:46:21 by angavrel          #+#    #+#             */\n/*   Updated: 2017/07/14 12:29:50 by fwuensch         ###   ########.fr       */\n/*                                                                            */\n/* ************************************************************************** */\n\n#include <unistd.h>\n\nint\t\tmain(int ac, char **av)\n{\n\tif (ac > 1)\n\t\twhile (*av[ac - 1])\n\t\t\twrite(1, av[ac - 1]++, 1);\n\twrite(1, \"\\n\", 1);\n\treturn (0);\n}\n",
